{
  "name": "google-workspace-mcp-server",
  "version": "1.0.0",
  "description": "Generic MCP server for Gmail draft/send and Google Docs append",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-workspace-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http --port 8787",
    "start:railway": "node dist/index.js --transport http --host 0.0.0.0",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --transport http --port 8787",
    "auth": "tsx scripts/auth-google.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "gmail",
    "google-docs",
    "google-workspace"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.6.1",
    "googleapis": "^159.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
